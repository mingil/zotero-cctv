# ==============================================================================
# Zotero Global CCTV - Environment Configuration (.env)
# ==============================================================================

# --- 1. Zotero API Configuration (Required) ---
# Find your numeric User ID and create an API Key at: https://www.zotero.org/settings/keys
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Library type: 'user' (personal library, default) or 'group' (shared lab group library)
ZOTERO_LIBRARY_TYPE=user

# --- 2. Telegram Push Alert Configuration (Required for Mobile Alerts) ---
# Create a bot via @BotFather on Telegram to obtain the token and your chat/channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 3. Audit Schedule & Notification Preferences (Optional) ---
# How often to scan the Zotero library (in hours, default: 6)
SCAN_INTERVAL_HOURS=6

# Choose which events trigger real-time Telegram push notifications
# (All events are always recorded in zotero_audit_global.log regardless of these flags)
ALERT_ON_DELETE=true
ALERT_ON_ADD=false
ALERT_ON_MOVE=false
